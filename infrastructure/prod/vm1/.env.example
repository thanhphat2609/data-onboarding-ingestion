# Prod VM 1. Copy to .env on the VM and fill in; never commit it. Values for env:// references go in sources.env.

# Shared PostgreSQL server of the data-onboarding-agent stack (ADR-0011): same values as its
# POSTGRES_AIRFLOW_PASSWORD. METADATA_DB_HOST only if the server isn't reachable as `postgres` on data-platform.
# PLATFORM_DB_PASSWORD (= its POSTGRES_PLATFORM_PASSWORD) comes with Phase 5 run records (docs/architecture.md §3.4).
AIRFLOW_DB_PASSWORD=__GENERATE__
METADATA_DB_HOST=

AIRFLOW_FERNET_KEY=__GENERATE__
AIRFLOW_JWT_SECRET=__GENERATE__
# Login `admin` in the Airflow UI; the Ingestion API uses it for "Run now" and pools.
AIRFLOW_ADMIN_PASSWORD=__GENERATE__

# Private IP or DNS name of VM 1, as seen from VM 2 (Flink RPC and blob server).
FLINK_JOBMANAGER_ADDRESS=10.0.0.4
JOBMANAGER_MEMORY=2048m

# Web UI port and the links it shows (empty = same host, ports 8080 and 8081).
UI_PORT=80
AIRFLOW_PUBLIC_URL=
FLINK_PUBLIC_URL=
