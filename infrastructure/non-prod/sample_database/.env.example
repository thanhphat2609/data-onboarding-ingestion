# Copied to .env by ../bootstrap.sh, which replaces every __GENERATE__ with a random value. .env is git-ignored.
# These are the test sources' own secrets. bootstrap.sh copies the read-only ones (listed in ../sources.env.example)
# to ../sources.env, where the platform reads them, as prod reads GitHub secrets (ADR-0013).

# SQL Server (database crm). SQL Server requires upper, lower, digit and symbol; generated values satisfy it.
MSSQL_SA_PASSWORD=__GENERATE__
CRM_SQLSERVER_RO_PASSWORD=__GENERATE__

# PostgreSQL (database sales) and MySQL (database shop): admin, then the read-only login svc_ingest_ro.
SALES_POSTGRES_ADMIN_PASSWORD=__GENERATE__
SALES_POSTGRES_RO_PASSWORD=__GENERATE__
SHOP_MYSQL_ROOT_PASSWORD=__GENERATE__
SHOP_MYSQL_RO_PASSWORD=__GENERATE__

# REST API (ADR-0015): its bearer token.
SHOP_API_TOKEN=__GENERATE__
