# Prod VM 2: every setting of infrastructure/prod/vm2/.env. All variables except ADLS_ACCOUNT_KEY (FLINK_JOBMANAGER_ADDRESS and the ADLS_* ones are shared with VM 1).
# The Deploy workflow writes this file on the VM from the repository secret or variable of the same name
# (infrastructure/prod/render_env.py, ADR-0013): set values in GitHub, never on the VM (replaced on every deploy).
# Values below are examples only. __GENERATE__ = required secret; the rest are variables. Setup: infrastructure/prod/README.md.

# Private addresses as seen from the other VM. VM 1 must reach VM 2 on 6121-6122; VM 2 must reach VM 1 on 6123-6124.
FLINK_JOBMANAGER_ADDRESS=10.0.0.4
# Same account and key as on VM 1 (ADLS_ACCOUNT_KEY is a secret, the only one here).
ADLS_STORAGE_ACCOUNT=<storage-account>
ADLS_ACCOUNT_KEY=__GENERATE__
FLINK_TASKMANAGER_ADDRESS=10.0.0.5

# Sized from the Phase 2 throughput results (open question 4).
TASKMANAGER_SLOTS=8
TASKMANAGER_MEMORY=8g
