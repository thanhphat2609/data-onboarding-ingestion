# Values for env://<VAR> references in pipelines/connections/*.yaml, read by the API, the Airflow scheduler (it
# mounts this file, ADR-0016) and the Flink JobManager. The Deploy workflow writes sources.env on VM 1 from the repository secrets of the same names
# (ADR-0013); every key is a required secret. Add a key here (and the secret) for each new env:// reference.
# Replaced by kv:// references (Phase 6).
CRM_SQLSERVER_RO_PASSWORD=
SALES_POSTGRES_RO_PASSWORD=
SHOP_MYSQL_RO_PASSWORD=
