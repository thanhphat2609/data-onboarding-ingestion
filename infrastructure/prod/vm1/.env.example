# Prod VM 1: every setting of infrastructure/prod/vm1/.env. Values for env:// references: sources.env.example.
# The Deploy workflow writes this file on the VM from the repository secret or variable of the same name
# (infrastructure/prod/render_env.py, ADR-0013): set values in GitHub, never on the VM (replaced on every deploy).
# Values below are examples only. __GENERATE__ = required secret; the rest are variables. Setup: infrastructure/prod/README.md.

# --- Secrets ---
# Fine-grained token limited to data-onboarding-orchestration, Contents and Pull requests (read and write): the
# Ingestion API opens a pull request there for every save (ADR-0017).
ORCHESTRATION_GITHUB_TOKEN=__GENERATE__
# Access key of the ADLS Gen2 account below; Flink writes the lake with it (VM 2 needs the same secret).
ADLS_ACCOUNT_KEY=__GENERATE__
# PLATFORM_DB_PASSWORD (= the agent stack's POSTGRES_PLATFORM_PASSWORD) comes with Phase 5 run records
# (docs/architecture.md §3.4).

# --- Variables ---
# ADLS Gen2 account (hierarchical namespace) the sinks write to; jobs set it as the sink's storage_account.
ADLS_STORAGE_ACCOUNT=<storage-account>
# Optional; empty = thanhphat2609/data-onboarding-orchestration and main.
ORCHESTRATION_REPOSITORY=
ORCHESTRATION_BASE_BRANCH=

# Required. Private IP or DNS name of VM 1, as seen from VM 2 (Flink RPC and blob server); same variable for VM 2.
FLINK_JOBMANAGER_ADDRESS=10.0.0.4
JOBMANAGER_MEMORY=2048m
# Redpanda, the landing of API sources (ADR-0015); it also advertises FLINK_JOBMANAGER_ADDRESS:19092 to VM 2.
REDPANDA_MEMORY=1G

# Web UI port and the links it shows (empty = same host, ports 8080 and 8081).
UI_PORT=80
AIRFLOW_PUBLIC_URL=
FLINK_PUBLIC_URL=
