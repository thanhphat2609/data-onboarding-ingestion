# Copied to .env by bootstrap.sh. .env is git-ignored. Airflow's settings are in data-onboarding-orchestration.

# The example sources' secrets are in example-sources/<source>/.env; the platform gets their read-only logins from sources.env.

# Optional: override the links in the Web UI. Empty means same host, ports 8080 and 8081.
AIRFLOW_URL=
FLINK_URL=

# Saving in the Web UI opens a pull request on data-onboarding-orchestration (ADR-0017).
# SAVE_MODE=disk keeps the files in the working copy only (no token needed, nothing reaches Airflow).
SAVE_MODE=pull_request
# A fine-grained personal access token limited to the orchestration repository: Contents and Pull requests,
# read and write. In a Codespace, add it as the user secret ORCHESTRATION_GITHUB_TOKEN instead of writing it here.
ORCHESTRATION_GITHUB_TOKEN=
ORCHESTRATION_REPOSITORY=thanhphat2609/data-onboarding-orchestration
ORCHESTRATION_BASE_BRANCH=main

# Optional: "mock" makes the Web UI use its in-browser mock instead of the Ingestion API.
API_MODE=http
