# Values for env://<VAR> references in pipelines/connections/*.yaml, read by the Ingestion API, Airflow and Flink.
# Non-prod twin of infrastructure/prod/vm1/sources.env.example: in prod each key is a GitHub secret that the Deploy
# workflow writes to VM 1 (ADR-0013, ADR-0014). Here bootstrap.sh fills sources.env from the example sources'
# .env files (example-sources/*/.env).
#
# A connection to another source: add its key here and to sources.env, then
#   docker compose -f infrastructure/non-prod/docker-compose.yml up -d
# (recreates the containers that read the file; in prod: add the GitHub secret, then run Deploy).
CRM_SQLSERVER_RO_PASSWORD=
SALES_POSTGRES_RO_PASSWORD=
SHOP_MYSQL_RO_PASSWORD=
SHOP_API_TOKEN=
