# Copied to .env by bootstrap.sh. .env is git-ignored. Airflow's settings are in data-onboarding-orchestration.

# The example sources' secrets are in example-sources/<source>/.env; the platform gets their read-only logins from sources.env.

# Optional: override the links in the Web UI. Empty means same host, ports 8080 and 8081.
AIRFLOW_URL=
FLINK_URL=

# Optional: "mock" makes the Web UI use its in-browser mock instead of the Ingestion API.
API_MODE=http
