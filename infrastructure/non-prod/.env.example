# Copied to .env by bootstrap.sh, which replaces every __GENERATE__ with a random value.
# .env is git-ignored. In Codespaces you can also set these as Codespaces secrets.

# Metadata DB (ADR-0011). local-db = run a local PostgreSQL (standalone Codespace).
# Empty = use the shared server of the data-onboarding-agent stack on this host (VM 1); then set
# AIRFLOW_DB_PASSWORD / PLATFORM_DB_PASSWORD to its POSTGRES_AIRFLOW_PASSWORD / POSTGRES_PLATFORM_PASSWORD.
COMPOSE_PROFILES=local-db

# POSTGRES_PASSWORD is only used by the local-db container.
POSTGRES_PASSWORD=__GENERATE__
AIRFLOW_DB_PASSWORD=__GENERATE__
PLATFORM_DB_PASSWORD=__GENERATE__
AIRFLOW_FERNET_KEY=__GENERATE__
AIRFLOW_JWT_SECRET=__GENERATE__

# The test sources' secrets are in sample_database/.env; the platform gets their read-only logins from sources.env.

# Optional: override the links in the Web UI. Empty means same host, ports 8080 and 8081.
AIRFLOW_URL=
FLINK_URL=

# Optional: "mock" makes the Web UI use its in-browser mock instead of the Ingestion API.
API_MODE=http
